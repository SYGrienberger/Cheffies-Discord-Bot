# --- Required -------------------------------------------------------------
# Bot token from https://discord.com/developers/applications → Bot
DISCORD_TOKEN=
# Application ID from the same page (General Information)
DISCORD_CLIENT_ID=
# 32 random bytes, base64. Encrypts users' YouTube keys at rest.
# Generate with: openssl rand -base64 32
# Changing it makes every stored key unreadable (users must /setkey again).
ENCRYPTION_KEY=

# --- Optional -------------------------------------------------------------
# Register slash commands in one server only (instant updates while developing).
# Leave empty to register globally.
DEV_GUILD_ID=
DB_PATH=./data/bot.db
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Path to the yt-dlp binary (https://github.com/yt-dlp/yt-dlp)
YTDLP_PATH=yt-dlp
# Extra yt-dlp flags, space-separated. Useful if YouTube blocks your server's IP:
# YTDLP_EXTRA_ARGS=--cookies /app/data/cookies.txt
YTDLP_EXTRA_ARGS=
# Leave the voice channel after this many seconds with nothing playing / nobody listening
IDLE_TIMEOUT_SECONDS=300
MAX_PLAYLIST_ITEMS=50
MAX_QUEUE_LENGTH=500
